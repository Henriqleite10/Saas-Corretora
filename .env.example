# Banco e fila (docker-compose local)
# DATABASE_URL: conexão de SISTEMA (owner — migrations, seed, onboarding, login)
# DATABASE_URL_APP: conexão de APLICAÇÃO (role radar_app, sujeita a RLS)
DATABASE_URL="postgresql://radar:radar@localhost:5432/radar_corretoras"
DATABASE_URL_APP="postgresql://radar_app:radar_app@localhost:5432/radar_corretoras"
REDIS_URL="redis://localhost:6379"

# IA (Anthropic)
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"
# Limite conservador de tokens/mês por tenant é configurado por tenant no banco
# (Tenant.limiteMensalTokensIa); consumo é medido em AiUsage.

# Criptografia (envelope encryption — KEK mestre local; KMS em produção)
# Gerar com: openssl rand -base64 32
MASTER_KEY=""
# Chave HMAC para hash de documentos (CPF/CNPJ) — gerar com: openssl rand -base64 32
DOC_HASH_KEY=""

# Auth
JWT_SECRET=""

# Notificações
RESEND_API_KEY=""
SMTP_URL=""
EMAIL_REMETENTE="cobranca@suacorretora.com.br"

# Feature flags
FEATURE_WHATSAPP="false"

# Nome comercial (não hardcodar marca no código)
PRODUCT_NAME="Radar Corretoras"
