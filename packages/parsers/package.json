{
  "name": "@radar/parsers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "tsup src/index.ts src/fixtures/index.ts --format esm,cjs --dts --sourcemap --clean",
    "gerar-fixtures": "tsx src/fixtures/gerar-arquivos.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.0.0",
    "tsup": "^8.3.5",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.13.9",
    "tsx": "^4.19.2"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./fixtures": {
      "import": {
        "types": "./dist/fixtures/index.d.ts",
        "default": "./dist/fixtures/index.js"
      },
      "require": {
        "types": "./dist/fixtures/index.d.cts",
        "default": "./dist/fixtures/index.cjs"
      }
    }
  },
  "dependencies": {
    "@radar/core": "workspace:*",
    "pdfkit": "^0.15.2",
    "xlsx": "^0.18.5",
    "pdfjs-dist": "^4.10.38"
  }
}
